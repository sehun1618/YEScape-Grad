{
  "output_root": "../results/current_correctness",
  "defaults": {
    "atom_file": "../structures/water8.xyz",
    "atom_unit": "Angstrom",
    "lattice_vectors": [
      [10.0, 0.0, 0.0],
      [0.0, 10.0, 0.0],
      [0.0, 0.0, 10.0]
    ],
    "lattice_unit": "Angstrom",
    "basis": "SZV-GTH",
    "pseudo": {
      "H": "GTH-SCAN-q1",
      "O": "GTH-SCAN-q6"
    },
    "auxbasis": "SZV-GTH",
    "gdf_setup_mode": "native",
    "rsdf_central_setup": "exact_gpu_source",
    "ke_cutoff_ha": 400.0,
    "precision": 1e-9,
    "kmesh": [1, 1, 1],
    "xc": "r2SCAN",
    "conv_tol": 1e-8,
    "conv_tol_grad": 1e-8,
    "max_cycle": 80,
    "num_threads": 64,
    "gpu_id": 0,
    "track_vram_peak": true,
    "vram_sample_interval_s": 0.05,
    "device_warmup": true,
    "z_solver": "matrix_free",
    "z_tolerance": 1e-12,
    "z_residual_tolerance": 1e-8,
    "z_max_cycle": 80,
    "z_nuclear_batch_memory_fraction": 0.05,
    "run_fd": true,
    "fd_step_bohr": 0.0001,
    "fd_atoms": [0],
    "fd_axes": ["z"]
  },
  "jobs": [
    {
      "name": "gdf_uniform",
      "device": "gpu",
      "df_backend": "gdf",
      "target_integrator": "uniform",
      "gdf_bilinear_mode": "one_pass_fused"
    },
    {
      "name": "rsdf_uniform",
      "device": "gpu",
      "df_backend": "rsdf",
      "target_integrator": "uniform"
    },
    {
      "name": "gdf_multigrid_xc",
      "device": "gpu",
      "df_backend": "gdf",
      "target_integrator": "multigrid_xc",
      "gdf_bilinear_mode": "one_pass_fused"
    },
    {
      "name": "rsdf_multigrid_xc",
      "device": "gpu",
      "df_backend": "rsdf",
      "target_integrator": "multigrid_xc"
    }
  ]
}
