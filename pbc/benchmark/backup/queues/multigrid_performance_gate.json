{
  "output_root": "../results/multigrid_performance_gate",
  "defaults": {
    "atom_file": "../../structures/water8.xyz",
    "atom_unit": "Angstrom",
    "lattice_vectors": [
      [10.0, 0.0, 0.0],
      [0.0, 10.0, 0.0],
      [0.0, 0.0, 10.0]
    ],
    "lattice_unit": "Angstrom",
    "basis": "SZV-GTH",
    "pseudo": {
      "H": "GTH-SCAN-q1",
      "O": "GTH-SCAN-q6"
    },
    "auxbasis": "SZV-GTH",
    "gdf_setup_mode": "native",
    "rsdf_central_setup": "exact_gpu_source",
    "ke_cutoff_ha": 400.0,
    "precision": 1e-9,
    "kmesh": [1, 1, 1],
    "xc": "r2SCAN",
    "conv_tol": 1e-8,
    "conv_tol_grad": 1e-8,
    "max_cycle": 80,
    "num_threads": 64,
    "gpu_id": 0,
    "track_vram_peak": true,
    "vram_sample_interval_s": 0.05,
    "device_warmup": true,
    "z_solver": "matrix_free",
    "z_tolerance": 1e-12,
    "z_residual_tolerance": 1e-8,
    "z_max_cycle": 80,
    "gdf_bilinear_mode": "one_pass_fused",
    "run_fd": false
  },
  "jobs": [
    {
      "name": "water8_repeat_01",
      "device": "gpu",
      "df_backends": ["gdf", "rsdf"],
      "target_integrators": [
        "uniform",
        "multigrid_xc",
        "multigrid_j_xc"
      ]
    },
    {
      "name": "water8_repeat_02",
      "device": "gpu",
      "df_backends": ["gdf", "rsdf"],
      "target_integrators": [
        "uniform",
        "multigrid_xc",
        "multigrid_j_xc"
      ]
    },
    {
      "name": "water8_repeat_03",
      "device": "gpu",
      "df_backends": ["gdf", "rsdf"],
      "target_integrators": [
        "uniform",
        "multigrid_xc",
        "multigrid_j_xc"
      ]
    },
    {
      "name": "water20_limited",
      "device": "gpu",
      "df_backends": ["gdf", "rsdf"],
      "target_integrators": [
        "uniform",
        "multigrid_xc",
        "multigrid_j_xc"
      ],
      "atom_file": "../../structures/water20.xyz"
    }
  ]
}
