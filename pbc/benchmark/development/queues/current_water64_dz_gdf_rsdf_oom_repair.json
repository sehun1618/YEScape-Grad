{
  "output_root": "../results/current_water64_dz_gdf_rsdf_oom_repair",
  "defaults": {
    "atom_file": "../../structures/water64.xyz",
    "atom_unit": "Angstrom",
    "lattice_vectors": [[12.4139, 0.0, 0.0], [0.0, 12.4139, 0.0], [0.0, 0.0, 12.4139]],
    "lattice_unit": "Angstrom",
    "basis": "DZVP-GTH",
    "pseudo": {
      "H": "GTH-SCAN-q1",
      "O": "GTH-SCAN-q6"
    },
    "auxbasis": "DZVP-GTH",
    "gdf_setup_mode": "native",
    "rsdf_central_setup": "exact_gpu_source",
    "rsdf_compressed_device_cache": "host",
    "ke_cutoff_ha": 500.0,
    "precision": 1e-09,
    "kmesh": [1, 1, 1],
    "xc": "r2SCAN",
    "conv_tol": 1e-08,
    "conv_tol_grad": 1e-08,
    "max_cycle": 80,
    "num_threads": 64,
    "gpu_id": 0,
    "track_vram_peak": true,
    "vram_sample_interval_s": 0.05,
    "device_warmup": true,
    "z_solver": "matrix_free",
    "z_tolerance": 1e-12,
    "z_residual_tolerance": 1e-08,
    "z_max_cycle": 80,
    "z_nuclear_batch_memory_fraction": 0.025,
    "z_nuclear_batch_max_components": 4,
    "gdf_derivative_omega_scale": 1.0,
    "rsdf_derivative_omega_scale": 1.0,
    "run_fd": false
  },
  "jobs": [
    {
      "name": "water64_dz_gdf_uniform_bounded_reverse",
      "enabled": true,
      "device": "gpu",
      "df_backend": "gdf",
      "target_integrator": "uniform",
      "gdf_bilinear_mode": "optimized_fused"
    },
    {
      "name": "water64_dz_rsdf_uniform_packed_from_origin",
      "enabled": true,
      "device": "gpu",
      "df_backend": "rsdf",
      "target_integrator": "uniform"
    }
  ],
  "benchmark_scope": "development"
}
