{
  "output_root": "results/multigrid_correctness_gate",
  "defaults": {
    "atom_file": "structures/h2.xyz",
    "atom_unit": "Angstrom",
    "lattice_vectors": [
      [6.0, 0.0, 0.0],
      [0.0, 6.0, 0.0],
      [0.0, 0.0, 6.0]
    ],
    "lattice_unit": "Bohr",
    "basis": "gth-szv",
    "pseudo": "gth-hf",
    "auxbasis": "gth-szv",
    "gdf_setup_mode": "native",
    "rsdf_central_setup": "exact_gpu_source",
    "ke_cutoff_ha": 20.0,
    "precision": 1e-9,
    "kmesh": [1, 1, 1],
    "xc": "PBE",
    "conv_tol": 1e-10,
    "conv_tol_grad": 1e-8,
    "max_cycle": 80,
    "num_threads": 32,
    "gpu_id": 0,
    "track_vram_peak": true,
    "vram_sample_interval_s": 0.05,
    "device_warmup": true,
    "z_solver": "matrix_free",
    "z_tolerance": 1e-12,
    "z_residual_tolerance": 1e-8,
    "z_max_cycle": 80,
    "run_fd": true,
    "fd_step_bohr": 0.001,
    "fd_atoms": [0],
    "fd_axes": ["z"]
  },
  "jobs": [
    {
      "name": "pbe_gamma",
      "device": "gpu",
      "df_backends": ["gdf", "rsdf"],
      "target_integrators": [
        "uniform",
        "multigrid_xc",
        "multigrid_j_xc"
      ]
    },
    {
      "name": "r2scan_sampled_k",
      "device": "gpu",
      "df_backends": ["gdf", "rsdf"],
      "target_integrators": ["multigrid_xc", "multigrid_j_xc"],
      "xc": "r2SCAN",
      "kmesh": [2, 1, 1]
    }
  ]
}
