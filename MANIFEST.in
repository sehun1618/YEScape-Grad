include README.md
include LICENSE
recursive-include examples *.py
recursive-include tests/structures *.xyz
recursive-include tests *.py *.md
exclude tests/structures/README.md
include pytest.ini
recursive-include environments *.yml *.md
prune dev
prune examples/dev
prune tests/results
prune tests/result
prune results
prune result
exclude THEORY.md
global-exclude __pycache__ *.py[cod] *.chk *.h5 *.log
