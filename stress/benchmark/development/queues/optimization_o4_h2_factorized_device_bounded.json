{
  "output_root": "../results/optimization_o4_h2_factorized_device_bounded",
  "defaults": {
    "atom_file": "../../structures/h2.xyz",
    "atom_unit": "Angstrom",
    "lattice_vectors": [[8.0, 0.0, 0.0], [0.0, 8.0, 0.0], [0.0, 0.0, 8.0]],
    "lattice_unit": "Bohr",
    "basis": "gth-szv",
    "pseudo": "gth-hf",
    "auxbasis": "gth-szv",
    "gdf_setup_mode": "native",
    "rsdf_central_setup": "exact_gpu_source",
    "ke_cutoff_ha": 400.0,
    "precision": 1e-10,
    "xc": "PBE",
    "conv_tol": 1e-10,
    "max_cycle": 80,
    "num_threads": 4,
    "gpu_id": 0,
    "device": "gpu",
    "target_integrator": "uniform",
    "calculation_mode": "stress_only",
    "stress_pp_response_backend": "gpu4pyscf_native_contracted_analytic_nonlocal_device",
    "stress_df_response_backend": "host_analytic_direct_contracted_factorized_device_bounded",
    "run_stress_fd": true,
    "stress_fd_components": ["xx"],
    "stress_fd_step": 0.00025,
    "stress_fd_tolerance_ha_per_bohr3": 1e-08,
    "checkpoint_resume": true,
    "track_vram_peak": true,
    "z_solver": "matrix_free"
  },
  "jobs": [
    {"name": "h2_gamma_gdf_factorized_device_bounded", "kmesh": [1, 1, 1], "df_backend": "gdf"},
    {"name": "h2_gamma_rsdf_factorized_device_bounded", "kmesh": [1, 1, 1], "df_backend": "rsdf"},
    {"name": "h2_k211_gdf_factorized_device_bounded", "kmesh": [2, 1, 1], "df_backend": "gdf"},
    {"name": "h2_k211_rsdf_factorized_device_bounded", "kmesh": [2, 1, 1], "df_backend": "rsdf"}
  ],
  "benchmark_scope": "development"
}
