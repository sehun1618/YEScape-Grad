    {"name": "water8_gdf_contracted_repeat_01", "df_backend": "gdf", "stress_pp_response_backend": "gpu4pyscf_native_contracted", "stress_df_response_backend": "gpu_fixed_density_fd_contracted"},
    {"name": "water8_gdf_contracted_repeat_02", "df_backend": "gdf", "stress_pp_response_backend": "gpu4pyscf_native_contracted", "stress_df_response_backend": "gpu_fixed_density_fd_contracted"},
    {"name": "water8_gdf_contracted_repeat_03", "df_backend": "gdf", "stress_pp_response_backend": "gpu4pyscf_native_contracted", "stress_df_response_backend": "gpu_fixed_density_fd_contracted"},
    {"name": "water8_rsdf_exact_repeat_01", "df_backend": "rsdf", "stress_pp_response_backend": "host_analytic_matrix", "stress_df_response_backend": "host_analytic_device_factorization"},
    {"name": "water8_rsdf_exact_repeat_02", "df_backend": "rsdf", "stress_pp_response_backend": "host_analytic_matrix", "stress_df_response_backend": "host_analytic_device_factorization"},
    {"name": "water8_rsdf_exact_repeat_03", "df_backend": "rsdf", "stress_pp_response_backend": "host_analytic_matrix", "stress_df_response_backend": "host_analytic_device_factorization"},
    {"name": "water8_rsdf_contracted_repeat_01", "df_backend": "rsdf", "stress_pp_response_backend": "gpu4pyscf_native_contracted", "stress_df_response_backend": "gpu_fixed_density_fd_contracted"},
    {"name": "water8_rsdf_contracted_repeat_02", "df_backend": "rsdf", "stress_pp_response_backend": "gpu4pyscf_native_contracted", "stress_df_response_backend": "gpu_fixed_density_fd_contracted"},
    {"name": "water8_rsdf_contracted_repeat_03", "df_backend": "rsdf", "stress_pp_response_backend": "gpu4pyscf_native_contracted", "stress_df_response_backend": "gpu_fixed_density_fd_contracted"}
