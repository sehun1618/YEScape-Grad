    "max_cycle": 80,
    "num_threads": 64,
    "gpu_id": 0,
    "device": "gpu",
    "target_integrator": "uniform",
    "calculation_mode": "stress_only",
    "run_stress_fd": false,
    "checkpoint_resume": false,
    "track_vram_peak": true,
    "device_warmup": true,
    "z_solver": "matrix_free"
  },
  "jobs": [
