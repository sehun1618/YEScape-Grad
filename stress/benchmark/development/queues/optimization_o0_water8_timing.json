{
  "output_root": "../results/optimization_o0_water8_timing",
  "defaults": {
    "atom_file": "../../structures/water8.xyz",
    "atom_unit": "Angstrom",
    "lattice_vectors": [[10.0, 0.0, 0.0], [0.0, 10.0, 0.0], [0.0, 0.0, 10.0]],
    "lattice_unit": "Angstrom",
    "basis": "SZV-GTH",
    "pseudo": {"H": "GTH-SCAN-q1", "O": "GTH-SCAN-q6"},
    "auxbasis": "SZV-GTH",
    "gdf_setup_mode": "native",
    "rsdf_central_setup": "exact_gpu_source",
    "ke_cutoff_ha": 400.0,
    "precision": 1e-09,
    "kmesh": [1, 1, 1],
    "xc": "r2SCAN",
    "conv_tol": 1e-08,
