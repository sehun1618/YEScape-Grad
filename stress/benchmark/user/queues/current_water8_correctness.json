{
  "output_root": "../results/current_water8_correctness",
  "defaults": {
    "atom_file": "../../structures/water8.xyz",
    "atom_unit": "Angstrom",
    "lattice_vectors": [[10.0, 0.0, 0.0], [0.0, 10.0, 0.0], [0.0, 0.0, 10.0]],
    "lattice_unit": "Angstrom",
    "basis": "SZV-GTH",
    "pseudo": {"H": "GTH-SCAN-q1", "O": "GTH-SCAN-q6"},
    "auxbasis": "SZV-GTH",
    "gdf_setup_mode": "native",
    "rsdf_central_setup": "exact_gpu_source",
    "ke_cutoff_ha": 400.0,
    "precision": 1e-09,
    "kmesh": [1, 1, 1],
    "xc": "r2SCAN",
    "conv_tol": 1e-08,
    "conv_tol_grad": 1e-08,
    "max_cycle": 80,
    "num_threads": 64,
    "gpu_id": 0,
    "track_vram_peak": true,
    "device_warmup": true,
    "checkpoint_resume": true,
    "z_solver": "matrix_free",
    "stress_pp_response_backend": "gpu4pyscf_native_contracted_analytic_nonlocal_device",
    "stress_df_response_backend": "host_analytic_source_adjoint_gpu_ft",
    "stress_df_device_memory_fraction": 0.85,
    "target_integrator": "uniform"
  },
  "jobs": [
    {
      "name": "gdf_selected_fd",
      "device": "gpu",
      "df_backend": "gdf",
      "calculation_mode": "stress_only",
      "run_stress_fd": true,
      "stress_fd_components": ["xx", "xy"],
      "stress_fd_step": 0.00025,
      "stress_fd_tolerance_ha_per_bohr3": 1e-05
    },
    {
      "name": "rsdf_selected_fd",
      "device": "gpu",
      "df_backend": "rsdf",
      "calculation_mode": "stress_only",
      "run_stress_fd": true,
      "stress_fd_components": ["xx", "xy"],
      "stress_fd_step": 0.00025,
      "stress_fd_tolerance_ha_per_bohr3": 1e-05
    },
    {
      "name": "energy_force_stress",
      "device": "gpu",
      "df_backends": ["gdf", "rsdf"],
      "calculation_mode": "gradient_and_stress",
      "run_stress_fd": false
    }
  ],
  "benchmark_scope": "user"
}
